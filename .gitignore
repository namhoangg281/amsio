# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which carries no values and documents what must be set.
# Matches apps/wisa-web and apps/exam-engine, which both track .env.example.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scripts with credentials (run locally only)
/scripts/
public/images/logo/logo-app-icon_upscayl_5x_upscayl-standard-4x.png

.vercel
