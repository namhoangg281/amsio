# AMSIO Website — environment variables
#
# Copy to .env.local for local dev. Every variable marked REQUIRED must also be set
# in Vercel (Project Settings → Environment Variables) or the corresponding feature
# fails. Several read paths in this app fall back silently on error, so a missing
# variable looks like "there is no content" rather than an error — hence this file.
#
# Derived from `grep -rhoE "process\.env\.[A-Z0-9_]+" src/` plus next.config.ts.

# ── Supabase (amsio project) ────────────────────────────────────────────────
# REQUIRED. Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://nnqwjreinqiohdxtqzkk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# REQUIRED for CMS writes and media upload (server-side only, never exposed).
# Used by src/lib/cms/queries.ts and src/app/api/v1/cms/media/route.ts.
SUPABASE_SERVICE_ROLE_KEY=

# ── CMS ─────────────────────────────────────────────────────────────────────
# REQUIRED. Tenant that owns all cms.* rows: core.tenants where code = 'amsio-international'.
# src/lib/cms/queries.ts getTenantId() throws without it, and every caller catches
# that and returns empty — so the public site silently serves the compiled TS locale
# files and the CMS dashboard shows empty lists. This was missed when the project was
# created because no env template existed (2026-08-20).
AMSIO_TENANT_ID=00000000-0000-0000-0000-000000000002

# ── AI ──────────────────────────────────────────────────────────────────────
# REQUIRED for the chatbox widget (src/app/api/v1/chatbox/route.ts).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Rate limiting ───────────────────────────────────────────────────────────
# Optional. src/lib/rate-limit.ts falls back to an in-memory limiter when unset,
# which does not hold across serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Optional ────────────────────────────────────────────────────────────────
# Leave empty for a custom domain; only set when serving under a sub-path.
NEXT_PUBLIC_BASE_PATH=
# Google Analytics measurement id. Analytics scripts are skipped when unset.
NEXT_PUBLIC_GA_ID=
